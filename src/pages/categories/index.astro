---
import { getAllPosts, getUniqueCategoriesWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allCategories = getUniqueCategoriesWithCount(allPosts);

const meta = {
	description: "A list of all the categories used to organise posts",
	title: "All Categories",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Categories</h1>
	{
		allCategories.length ? (
			<ul class="space-y-4">
				{allCategories.map(([category, count]) => (
					<li class="flex items-center gap-x-2">
						<a
							class="cactus-link inline-block"
							href={`/categories/${category}/`}
							title={`View posts in the category: ${category}`}
						>
							{category}
						</a>
						<span class="inline-block">
							- {count} Post{count > 1 && "s"}
						</span>
					</li>
				))}
			</ul>
		) : (
			<p>No categories have been added yet.</p>
		)
	}
</PageLayout>
