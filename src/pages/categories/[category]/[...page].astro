---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueCategories } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueCategories = getUniqueCategories(sortedPosts);

	return uniqueCategories.flatMap((category) => {
		const postsInCategory = sortedPosts.filter((post) => post.data.categories.includes(category));
		return paginate(postsInCategory, {
			pageSize: 10,
			params: { category },
		});
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { category } = Astro.params;

const meta = {
	description: `View all posts in the category - ${category}`,
	title: `Posts in ${category}`,
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Previous Posts",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Next Posts →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<nav class="mb-8" aria-label="Breadcrumbs">
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href="/categories/">Categories</a>
				<Icon aria-hidden="true" name="mdi:chevron-right" class="mx-1.5" />
			</li>
			<li aria-current="page">{category}</li>
		</ul>
	</nav>
	<h1 class="title capitalize">Posts in {category}</h1>
	<ul class="mt-16 space-y-4">
		{
			page.data.map((post) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview as="h2" post={post} />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
